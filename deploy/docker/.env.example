# 复制成 .env 后修改；生产环境必须替换所有密码与 Token 密钥
MYSQL_ROOT_PASSWORD=change-me-root
VERYAL_DB_USER=veryal
VERYAL_DB_PASSWORD=change-me-db
VERYAL_TOKEN_SECRET=change-me-to-at-least-32-characters
VERYAL_GATEWAY_ID=gateway-1
VERYAL_NODE_ID=1
VERYAL_MQ_USER=veryal
VERYAL_MQ_PASSWORD=change-me-mq

# 对象存储（S3 兼容，容器名 veryal-s3 = Garage）
# Key 用 garage key create 生成后填这里，不要用容器 root 凭据
VERYAL_STORAGE_TYPE=minio
VERYAL_S3_ACCESS_KEY=GK-change-me
VERYAL_S3_SECRET_KEY=change-me
VERYAL_MINIO_BUCKET=veryal
VERYAL_MINIO_REGION=us-east-1
# 客户端可达的公网地址，仅用于签名临时 URL；只开 nginx 8899 时留空
VERYAL_MINIO_PUBLIC_ENDPOINT=

# 接阿里云 OSS 时改成 oss，并填下面四项
# VERYAL_STORAGE_TYPE=oss
# VERYAL_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# VERYAL_OSS_ACCESS_KEY_ID=
# VERYAL_OSS_ACCESS_KEY_SECRET=
# VERYAL_OSS_BUCKET=veryal
